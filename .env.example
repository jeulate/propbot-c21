# ===========================================
# Century 21 Rita Quiroga — Control de Cierres
# Variables de entorno
# ===========================================
# Copia este archivo como .env.local y completa los valores reales.
# NUNCA subas .env.local a GitHub.

# --- Telegram ---
# Obtén el token hablando con @BotFather en Telegram (/newbot)
TELEGRAM_BOT_TOKEN=
# ID de tu chat personal
TELEGRAM_CHAT_ID=

# Token secreto propio (cualquier cadena aleatoria) para verificar que las
# llamadas al webhook realmente vienen de Telegram. Genera uno con:
# openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# --- Vercel KV (Redis) ---
# Estas dos variables las genera Vercel automáticamente cuando conectas un
# KV Store (Storage > Create Database > KV) a tu proyecto. Para desarrollo
# local, cópialas desde el dashboard de Vercel (Settings > Environment Variables).
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# --- Autenticación del dashboard ---
# Secreto usado para firmar los JWT de sesión. Genera uno con:
# openssl rand -base64 32
AUTH_SECRET=

# --- Despliegue ---
# URL pública de tu deploy en Vercel, usada por el script bot:webhook:set
# Ejemplo: https://propbot-c21.vercel.app
APP_URL=
